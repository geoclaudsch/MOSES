import numpy as np
import matplotlib.pyplot as plt
from sklearn.cluster import KMeans
from sklearn.datasets import make_blobs
from sklearn.preprocessing import StandardScaler
from sklearn.metrics import rand_score, adjusted_rand_score

# Beispiel-Datensatz erstellen
X, y_true = make_blobs(n_samples=300, centers=4, cluster_std=0.6, random_state=42)

# Daten standardisieren
scaler = StandardScaler()
X_scaled = scaler.fit_transform(X)

# K-Means anwenden
kmeans = KMeans(n_clusters=4,init='k-means++', random_state=42)
y_pred = kmeans.fit_predict(X_scaled)

# Rand-Index berechnen
ri = rand_score(y_true, y_pred)
ari = adjusted_rand_score(y_true, y_pred)

print("Rand-Index (RI):", ri)
print("Adjusted Rand-Index (ARI):", ari)

# Zentroiden in den ursprünglichen Raum zurücktransformieren
original_centers = kmeans.cluster_centers_

# Visualisierung der Cluster
plt.scatter(X_scaled[:, 0], X_scaled[:, 1], c=y_pred, cmap='viridis', s=50, alpha=0.6)
plt.scatter(original_centers[:, 0], original_centers[:, 1], s=100, c='red', label='Zentroiden')
plt.title("K-Means Clustering")
plt.xlabel("Feature 1")
plt.ylabel("Feature 2")
plt.legend()
plt.show()

